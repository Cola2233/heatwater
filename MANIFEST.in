include README.md LICENSE DATA_LICENSE.md CITATION.cff CHANGELOG.md CONTRIBUTING.md
include environment.yml config/example.json
include data/README.md
include package.json package-lock.json DESIGN.md direction-approved.md SECURITY.md CODE_OF_CONDUCT.md
include website/index.html website/style.css website/core.js website/charts.js website/app.js
include website/README.md website/data/demo.js
include website/temperature-demo.html
include website/seasonal-temperature.html
include website/blocks.css website/blocks.js website/blocks-core.js
include website/feedback-core.js website/map-feedback.js website/map-feedback.css
include website/stability-core.js
recursive-include website/tests *.cjs
